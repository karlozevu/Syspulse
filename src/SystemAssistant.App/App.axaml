<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SystemAssistant.App.App"
             RequestedThemeVariant="Default">
    <!--
      自定义调色板：默认给出浅色值，ThemeService.Apply 会在切换 / 跟随系统主题时
      原地替换这些 SolidColorBrush 的 Color。所有自定义样式都用 DynamicResource 引用，
      因此浅色、深色、跟随系统三种模式都有正确对比度，不会再出现固定深红深金看不见的情况。
    -->
    <Application.Resources>
        <SolidColorBrush x:Key="SaAccentBrush" Color="#0F6CBD" />
        <SolidColorBrush x:Key="SaAccentSoftBrush" Color="#E5F1FC" />
        <SolidColorBrush x:Key="SaWarnBrush" Color="#93620A" />
        <SolidColorBrush x:Key="SaWarnSoftBrush" Color="#FFF4D6" />
        <SolidColorBrush x:Key="SaDangerBrush" Color="#C42B1C" />
        <SolidColorBrush x:Key="SaDangerSoftBrush" Color="#FDECEA" />
        <SolidColorBrush x:Key="SaSuccessBrush" Color="#0E7A3C" />
        <SolidColorBrush x:Key="SaSelectionBrush" Color="#D8EAFB" />
        <SolidColorBrush x:Key="SaHoverBrush" Color="#E9F1F9" />
        <SolidColorBrush x:Key="SaRowAltBrush" Color="#F6F8FB" />
        <SolidColorBrush x:Key="SaDividerBrush" Color="#E1E7EF" />
        <SolidColorBrush x:Key="SaCardBorderBrush" Color="#DEE5EE" />
        <SolidColorBrush x:Key="SaHeaderBrush" Color="#F1F5FA" />
        <SolidColorBrush x:Key="SaSidebarBrush" Color="#F8FAFD" />
        <SolidColorBrush x:Key="SaMutedTextBrush" Color="#5C6675" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://SystemAssistant/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
