<Project Sdk="Microsoft.NET.Sdk">
  <!-- Avalonia UI 层：页面、ViewModel、弹窗、主题、多语言 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <RootNamespace>SystemAssistant.App</RootNamespace>
    <AssemblyName>SystemAssistant</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Win32 exe 图标（资源管理器、任务栏、快捷方式都会使用它） -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia 窗口图标用 PNG（Skia 解码器对 PNG 支持最稳妥），ICO 供 Win32 使用 -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SystemAssistant.Core\SystemAssistant.Core.csproj" />
    <ProjectReference Include="..\SystemAssistant.Models\SystemAssistant.Models.csproj" />
    <ProjectReference Include="..\SystemAssistant.Utils\SystemAssistant.Utils.csproj" />
  </ItemGroup>
</Project>
