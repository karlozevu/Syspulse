<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 国内网络环境下 api.nuget.org 可能被重定向到 azure.cn 镜像，这里显式声明两个源提高还原成功率 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="nuget-azure-cn" value="https://nuget.azure.cn/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
